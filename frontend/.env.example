# =============================================================================
# EV Fleet Intelligence — frontend public configuration (TEMPLATE)
# =============================================================================
# Copy this file to `.env` and replace every placeholder with your real value:
#
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#
# `.env` is git-ignored. This template is committed with placeholders only.
#
# SAFE FOR THE CLIENT (all of the below are public identifiers):
#   These values ship inside the app binary. That is expected and safe.
#
# NEVER ADD TO THIS FILE:
#   AWS_SECRET_ACCESS_KEY, AWS_ACCESS_KEY_ID, any database password,
#   COGNITO_CLIENT_SECRET, RDS credentials, JWT signing keys, session tokens.
#   The Cognito app client used by a mobile app must be a public client
#   WITHOUT a client secret. Those secrets belong only on the Spring Boot
#   server (EC2 environment variables / SSM Parameter Store).
# =============================================================================

# --- Spring Boot API origin -----------------------------------------------
# Your deployed backend, no trailing slash.
# Production must be HTTPS (the app rejects plaintext HTTP in release builds,
# except for loopback addresses used in local development).
# Get it from: EC2 → Instances → your instance → Public IPv4 / Elastic IP,
# or EC2 → Load Balancers → DNS name if you fronted the API with an ALB.
API_BASE_URL=https://example.com

# --- Amazon Cognito --------------------------------------------------------
# Get the region from the AWS Console region selector (top-right) while the
# User Pool is open. It must match the User Pool ID prefix.
AWS_REGION=ap-south-1a

# Cognito → User pools → <your pool> → Overview → "User pool ID"
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxx

# Cognito → User pools → <your pool> → App integration → App clients →
# "Client ID". Use an app client with NO client secret (public client).
COGNITO_APP_CLIENT_ID=yours

# --- Optional -------------------------------------------------------------
# Cognito hosted-UI redirect URI. Only needed if you enable a browser-based
# OAuth flow. Leave empty for the username/password flows the app uses.
COGNITO_REDIRECT_URI=

# --- Local development only -----------------------------------------------
# true  → serve the in-memory sample dataset, no network and no Cognito.
# false → always talk to the real backend (default).
# Never ship a release build with DEMO_MODE=true.
DEMO_MODE=false
