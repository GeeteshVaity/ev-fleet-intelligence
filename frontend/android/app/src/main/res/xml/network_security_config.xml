<?xml version="1.0" encoding="utf-8"?>
<!--
  Narrowest practical cleartext exception for the HTTP-only demo backend.

  The deployed API is reached over http://13.204.143.82:8080, so cleartext is
  permitted for that single address (plus the local development hosts used by
  the Android emulator and desktop). Everything else requires TLS.

  PRODUCTION: put the backend behind HTTPS (ACM certificate / ALB or an
  Elastic Beanstalk/CloudFront origin) and delete the 13.204.143.82 entry so
  that base-config's cleartext ban applies everywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Deployed demo backend (AWS EC2, ap-south-1) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">13.204.143.82</domain>
    </domain-config>

    <!-- Local development only: Android emulator host loopback + desktop -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
